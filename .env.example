# Port Configuration
WEB_PORT=4444
API_PORT=4445

# Application
NODE_ENV=development

# Development Settings
DEV_MODE=true

# Security (change these in production)
SESSION_SECRET=tabsh_session_secret_development_only

# Testing
TEST_PORT=4446
TEST_TIMEOUT=30000

# Docker Settings
DOCKER_COMPOSE_PROJECT_NAME=tabsh

# Logging
LOG_LEVEL=info